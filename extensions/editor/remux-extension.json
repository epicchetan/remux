{
  "version": 1,
  "id": "editor",
  "name": "Viewer",
  "display": {
    "title": "Viewer",
    "icon": "assets/editor.png",
    "iconDark": "assets/editor-dark.png"
  },
  "views": {
    "main": {
      "route": "/viewers/editor",
      "entry": "viewer/dist/index.html",
      "cache": "immutable",
      "build": {
        "command": "npm",
        "args": [
          "run",
          "build"
        ],
        "cwd": "."
      },
      "watch": {
        "command": "npm",
        "args": [
          "run",
          "watch"
        ],
        "cwd": "."
      }
    }
  },
  "launchers": [],
  "fileHandlers": [
    {
      "id": "document-viewer",
      "view": "main",
      "label": "Viewer",
      "extensions": [
        "md",
        "markdown",
        "mdown",
        "html",
        "htm"
      ]
    },
    {
      "id": "text-editor",
      "view": "main",
      "label": "Viewer",
      "extensions": [
        "*"
      ]
    }
  ]
}
