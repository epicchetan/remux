{
  "name": "@remux/agent",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:server && npm run build:viewer",
    "build:server": "vite build --config server/vite.config.ts",
    "build:viewer": "vite build --config viewer/vite.config.ts",
    "test": "npm run test:server && npm run test:unit && npm run test:viewer",
    "test:server": "node --test --experimental-strip-types tests/*.test.ts",
    "test:live:replay": "node --experimental-strip-types tests/live/replay-smoke.ts",
    "test:live:h4": "node --experimental-strip-types tests/live/h4-lifecycle-smoke.ts",
    "test:live:memory": "node --experimental-strip-types tests/live/working-memory-smoke.ts",
    "test:live:clean": "node tests/live/clean-acceptance.mjs",
    "test:live:viewer": "node tests/live/viewer-acceptance.mjs",
    "test:hardening": "node --experimental-strip-types tests/hardening/transcript-scale.ts",
    "test:context-corpus": "node --experimental-strip-types tests/benchmark/context-corpus.ts",
    "benchmark": "node --experimental-strip-types tests/benchmark/benchmark.ts",
    "storage:scrub": "node --experimental-strip-types server/src/storage/scrub.ts",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "test:viewer": "playwright test -c playwright.config.ts",
    "watch": "vite build --watch --config viewer/vite.config.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.7",
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@iconify/icons-vscode-icons": "^1.2.29",
    "@lexical/react": "^0.44.0",
    "@remux/viewer-kit": "*",
    "lexical": "^0.44.0",
    "lucide-react": "^1.14.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm-table": "^2.0.0",
    "micromark-extension-gfm-table": "^2.1.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "shiki": "^4.1.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typebox": "1.3.7",
    "uuid": "^14.0.0",
    "zustand": "^5.0.13"
  }
}
